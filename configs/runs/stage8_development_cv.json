      "logistic_regression__yeo_johnson",
      "random_forest",
      "lightgbm"
    ],
    "rule": "per feature set, the candidate with the highest CV AP mean; exact tie -> the simpler (earlier) candidate; one held-out evaluation per feature set",
    "never_selected": [
      "dummy_prior",
      "stratified_random",
      "naming_heuristic"
    ]
  },
