  "primary_metric": "average_precision",
  "primary_feature_set": "main",
  "cv_result": "mean and sample std (ddof=1) of the 5 validation-fold APs",
  "threshold_rule": "max F1 on pooled development OOF scores; lowest threshold on ties; development threshold metrics are optimistic",
